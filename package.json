{
  "name": "vue-email-editor",
  "version": "2.2.0",
  "main": "dist/vue-email-editor.es.js",
  "types": "dist/vue-email-editor.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue-email-editor.es.js",
      "require": "./dist/vue-email-editor.umd.js",
      "types": "./dist/vue-email-editor.d.ts"
    }
  },
  "scripts": {
    "serve": "vue-cli-service serve",
