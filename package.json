    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/cli-plugin-typescript": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vue": "^3.2.13",
    "vue-dts-gen": "^0.3.0",
    "vue-loader": "^17.4.2",
    "vue-router": "^4.4.0",
    "vue-template-compiler": "^2.7.16",
    "vue-tsc": "^2.0.22"
  },
  "files": [
    "dist"
